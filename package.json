{
  "name": "learning-companion-pwa",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "dev:check": "node scripts/dev.mjs --check",
    "server:build": "tsc -p server/tsconfig.json",
    "server:dev": "tsc -p server/tsconfig.json && node server/dist/index.js",
    "test:server": "tsc -p server/tsconfig.json && node server/tests/generation-tasks.mjs && node server/tests/course-strategy.mjs && node server/tests/chapter-tool-library.mjs && node server/tests/web-search-smoke.mjs",
    "migrate:store": "node scripts/migrate-store.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "^0.45.2",
    "i18next": "^26.3.6",
    "jsonwebtoken": "^9.0.3",
    "katex": "^0.18.1",
    "nodemailer": "^9.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.11",
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10"
  }
}
