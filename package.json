{
  "name": "learning-companion-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "dev:check": "node scripts/dev.mjs --check",
    "server:build": "tsc -p server/tsconfig.json",
    "server:dev": "tsc -p server/tsconfig.json && node server/dist/index.js",
    "test:server": "tsc -p server/tsconfig.json && node server/tests/web-search-smoke.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  }
}
