# Required. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=replace-with-a-random-32-byte-base64-key

# Safe default: only the current machine can access the app.
BIND_ADDRESS=127.0.0.1
APP_PORT=8080

# Optional. Leave empty to configure provider keys in the Settings page.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com/search
