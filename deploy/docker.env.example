# Required. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=replace-with-a-random-32-byte-base64-key

# Required in production. Signing key for login tokens; generate a long random string.
JWT_SECRET=replace-with-a-long-random-string

# SQLite database lives on the data volume by default (/app/data/learning-studio.db);
# set APP_DB_PATH only if you need to relocate it inside the container.
APP_DB_PATH=/app/data/learning-studio.db

# Safe default: only the current machine can access the app.
BIND_ADDRESS=127.0.0.1
APP_PORT=8080
# HTTPS(自签证书)端口,访问 https://<BIND_ADDRESS>:HTTPS_PORT
HTTPS_PORT=8443

# Optional. Leave empty to configure provider keys in the Settings page.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com/search

# 邮件(SMTP)配置 —— 可选。不填时生产环境无法发送注册验证码。
# 发件邮箱不要求是真实存在的“正规”邮箱:配置假的发件地址、测试 SMTP 站点
# (如 Mailpit / MailHog / smtp4dev)都可以,邮件被接收方归入垃圾邮件不影响功能。
SMTP_HOST=
SMTP_PORT=587
# 465 端口或使用 SSL 时设为 true
SMTP_SECURE=false
# 发件账号。无认证的假 SMTP 站点可留空
SMTP_USER=
SMTP_PASSWORD=
# 发件人显示地址,不填默认用 SMTP_USER(如 noreply@your-domain.com,可以是不存在的地址)
SMTP_FROM=
# 连接无有效证书的假 SMTP 站点(自签证书)时设为 true,跳过证书校验
SMTP_ALLOW_INSECURE_TLS=false
# 完全没有 SMTP 时设为 true:验证码回显到页面/日志(等同本地开发模式),测试用
MAIL_ECHO_CODE=false
